<!DOCTYPE html>
<html lang="ru">
<head>
    <title>Lab10 - Ассиметричные шифры RSA и Эль-Гамаля</title>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

    <style>
        body {
            background: linear-gradient(135deg, #0f172a, #1e293b);
            color: #e2e8f0;
            min-height: 100vh;
        }

        .container {
            max-width: 1000px;
            margin-top: 40px;
        }

        .nav {
            background: rgba(255,255,255,0.05);
            padding: 10px;
            border-radius: 12px;
            backdrop-filter: blur(10px);
        }

        .nav-link {
            color: #cbd5e1;
            font-weight: 500;
            transition: 0.3s;
        }

        .nav-link:hover {
            color: #38bdf8;
            transform: scale(1.05);
        }

        .nav-link.active {
            color: #38bdf8 !important;
            font-weight: 600;
        }

        h2 {
            margin-top: 25px;
            margin-bottom: 30px;
            font-weight: 700;
            color: #f1f5f9;
        }

        .data-box {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            transition: 0.3s;
        }

        .data-box:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.4);
        }

        .encrypted-data {
            background: rgba(15, 23, 42, 0.7);
            padding: 15px;
            border-radius: 10px;
            font-family: monospace;
            color: #a5f3fc;
            word-break: break-all;
        }

        .lead {
            font-size: 18px;
            color: #e2e8f0;
        }

        .time-badge {
            background: #0ea5e9;
            color: white;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            margin-left: 10px;
        }

        .key-box {
            font-family: monospace;
            font-size: 14px;
            color: #a7f3d0;
            word-break: break-all;
        }

        .row .data-box {
            height: 100%;
        }
    </style>
</head>

<body>
<div class="container animate__animated animate__fadeIn">

    <ul class="nav justify-content-center mb-4">
        <li class="nav-item">
            <a class="nav-link active" href="/rsa">RSA</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="/el-gamal">Эль-Гамаля</a>
        </li>
    </ul>

    <h2 class="text-center">RSA</h2>

    <div class="data-box">
        <h5 class="text-center">Оригинальное сообщение</h5>
        <p class="text-center lead"><%= originalText %></p>
    </div>

    <div class="row g-3">

        <div class="col-md-6">
            <div class="data-box">
                <h5 class="text-center">Приватный ключ</h5>
                <div class="key-box text-center">
                    <%= privateKey %>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="data-box">
                <h5 class="text-center">Публичный ключ</h5>
                <div class="key-box text-center">
                    <%= publicKey %>
                </div>
            </div>
        </div>

    </div>

    <div class="data-box">
        <h5 class="text-center">
            Зашифрованное сообщение
            <span class="time-badge"><%= encryptionTime %> мс</span>
        </h5>
        <div class="encrypted-data"><%= encryptedData %></div>
    </div>

    <div class="data-box">
        <h5 class="text-center">
            Расшифрованное сообщение
            <span class="time-badge"><%= decryptionTime %> мс</span>
        </h5>
        <p class="lead text-center"><%= decryptedData %></p>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>