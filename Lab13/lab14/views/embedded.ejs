<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LSB Steganography | Лабораторная работа</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --bg-color: #f4f6f9;
            --card-bg: #ffffff;
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --text-main: #1f2937;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 0;
        }

        .container {
            max-width: 600px;
        }

        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            background: var(--card-bg);
            overflow: hidden;
        }

        .card-header {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-hover));
            color: #ffffff;
            font-weight: 600;
            font-size: 1.25rem;
            text-align: center;
            padding: 20px;
            border-bottom: none;
            letter-spacing: 0.5px;
        }

        .card-body {
            padding: 40px;
        }

        .card-title {
            color: #4b5563;
            font-weight: 500;
        }

        .form-label {
            font-weight: 600;
            font-size: 0.9rem;
            color: #374151;
            margin-bottom: 8px;
        }

        .form-control, .form-select {
            border: 1.5px solid #e5e7eb;
            border-radius: 10px;
            padding: 10px 14px;
            transition: all 0.2s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

        .form-text {
            font-size: 0.8rem;
            color: #9ca3af;
            margin-top: 6px;
        }

        .form-check-input:checked {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

        /* Кнопка отправки */
        .btn-primary {
            background-color: var(--primary-color);
            border: none;
            border-radius: 10px;
            padding: 12px 24px;
            font-weight: 600;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
        }

        .btn-primary:active {
            transform: scale(0.98);
        }

        /* Блок результатов */
        #result {
            border-radius: 12px;
            padding: 20px;
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
        }

        /* CSS Лоадер внутри кнопки */
        .loader {
            display: none;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="card">
        <div class="card-header">
            🔒 LSB Стеганография
        </div>
        <div class="card-body">
            <h5 class="card-title text-center mb-4">Внедрение сообщения в изображение</h5>
            <form id="steg_form">
                <div class="mb-3">
                    <label for="method" class="form-label">Метод внедрения</label>
                    <select class="form-select" id="method" required name="method">
                        <option value="rows" selected>По строкам</option>
                        <option value="cols">По столбцам</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label for="message" class="form-label">Сообщение для внедрения</label>
                    <textarea class="form-control" name="message" id="message" rows="3" placeholder="Введите секретный текст..." required></textarea>
                    <div class="form-text">Максимальная длина зависит от размера изображения</div>
                </div>
                
                <div class="mb-3">
                    <label for="image" class="form-label">Изображение-контейнер</label>
                    <input type="file" class="form-control" name="image" id="image" required accept="image/png">
                    <div class="form-text">Допускаются только PNG-изображения</div>
                </div>
                
                <div class="mb-4 form-check form-switch">
                    <input class="form-check-input" name="matrix" type="checkbox" id="flexCheckDefault">
                    <label class="form-check-label" for="flexCheckDefault">
                        Создать цветовые матрицы для анализа
                    </label>
                </div>
                
                <button type="submit" class="btn btn-primary">
                    <span id="submit-text">Внедрить сообщение</span>
                    <div id="loader" class="loader"></div>
                </button>
            </form>
            
            <div id="result" class="mt-4" style="display: none;"></div>
        </div>
    </div>
</div>

<script>
    const form = document.getElementById('steg_form');
    const resultDiv = document.getElementById('result');
    const submitText = document.getElementById('submit-text');
    const loader = document.getElementById('loader');
    
    form.onsubmit = async (event) => {
        event.preventDefault();
        
        // Показываем индикатор загрузки
        submitText.style.display = 'none';
        loader.style.display = 'block';
        resultDiv.style.display = 'none';
        
        try {
            const response = await fetch('/embedded', {
                method: 'POST',
                body: new FormData(form)
            });
            
            if (response.ok) {
                const res = await response.json();
                resultDiv.innerHTML = `
                    <h5 class="text-success fw-bold mb-2">✓ Успешно!</h5>
                    <p class="mb-1">Извлечённое сообщение для проверки: <strong class="text-dark">${res.result}</strong></p>
                    <small class="text-muted">Изображение с внедрённым сообщением сохранено на сервере.</small>
                `;
                resultDiv.style.display = 'block';
            } else {
                throw new Error('Ошибка сервера при обработке');
            }
        } catch (error) {
            resultDiv.innerHTML = `
                <h5 class="text-danger fw-bold mb-2"> Ошибка!</h5>
                <p class="mb-0 text-secondary">${error.message}</p>
            `;
            resultDiv.style.display = 'block';
        } finally {
            submitText.style.display = 'inline';
            loader.style.display = 'none';
        }
    };
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>